{
  "name": "crossgantt",
  "version": "2.0.0",
  "private": true,
  "description": "Backlog の複数プロジェクト・複数担当者の課題を 1 枚のガントチャートで横断表示するビューア",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-gas.mjs",
    "smoke": "node scripts/smoke.mjs",
    "push": "pnpm run build && clasp push --force",
    "deploy": "pnpm run build && node scripts/deploy-gas.mjs",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run lint:css && pnpm run lint:md && pnpm run lint:actions && pnpm run spellcheck && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke",
    "lint:actions": "node scripts/actionlint.mjs",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint --fix \"**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "spellcheck": "cspell --no-progress --show-suggestions --dot \"**\""
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/google-apps-script": "2.0.13",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "actionlint": "2.0.6",
    "cspell": "10.3.0",
    "esbuild": "0.28.2",
    "eslint-plugin-css-modules": "2.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.13.2",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.0+sha512.d7bd39a488131de200aeec1dbc9ca58b890437f09b1f925b1bf820fdc463df01a329e3699c3d8a7bb186d5cf3f75cb68ce820c69d6b2c983525bc0821de4c529"
}
