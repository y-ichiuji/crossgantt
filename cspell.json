{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "caseSensitive": false,
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    ".wrangler/**",
    "pnpm-lock.yaml",
    "worker-configuration.d.ts",
    "skills/**",
    "public/**",
    ".git/**"
  ],
  "dictionaries": ["typescript", "node", "npm", "html", "css", "softwareTerms", "companies", "filetypes"],
  "words": [
    "actionlint",
    "backlogtool",
    "codeql",
    "corepack",
    "crossgantt",
    "cspell",
    "datetime",
    "dedupe",
    "displayorder",
    "findy",
    "gantt",
    "getsetcookie",
    "ghsa",
    "grapheme",
    "hackathon",
    "hono",
    "ichiuji",
    "issuekey",
    "kaku",
    "libheif",
    "millis",
    "miniflare",
    "nodate",
    "nulab",
    "openharmony",
    "openssf",
    "oxfmt",
    "oxlint",
    "rolldown",
    "segmenter",
    "tsgo",
    "tsgolint",
    "unhover",
    "unstyled",
    "vitest",
    "workerd",
    "wrangler",
    "yusukebe",
    "zunda"
  ],
  "ignoreRegExpList": ["/[\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Han}ー－、。「」（）]+/gu"]
}
