{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "caseSensitive": false,
  "ignorePaths": ["node_modules/**", "dist/**", "gas-dist/**", "pnpm-lock.yaml", ".git/**"],
  "dictionaries": ["typescript", "node", "npm", "html", "css", "softwareTerms", "companies", "filetypes"],
  "words": [
    "actionlint",
    "appsscript",
    "backlogtool",
    "clasp",
    "clasprc",
    "codeql",
    "corepack",
    "crossgantt",
    "cspell",
    "datetime",
    "dedupe",
    "displayorder",
    "gantt",
    "grapheme",
    "ichiuji",
    "indexeddb",
    "issuekey",
    "kaku",
    "markdownlint",
    "millis",
    "nodate",
    "nulab",
    "openharmony",
    "openssf",
    "oxfmt",
    "oxlint",
    "rolldown",
    "segmenter",
    "shellcheck",
    "stylelint",
    "tsgo",
    "tsgolint",
    "unhover",
    "unstyled",
    "vitest",
    "zunda"
  ],
  "ignoreRegExpList": ["/[\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Han}ー－、。「」（）]+/gu"]
}
