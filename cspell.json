{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "caseSensitive": false,
  // .gitignore に載っているものは対象外。取得してきた skills も同様に見ない。
  "useGitignore": true,
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "gas-dist/**",
    "pnpm-lock.yaml",
    ".git/**",
    ".agents/**",
    ".claude/skills/**"
  ],
  "dictionaries": ["typescript", "node", "npm", "html", "css", "softwareTerms", "companies", "filetypes"],
  "words": [
    "actionlint",
    "appsscript",
    "backlogtool",
    "clasp",
    "clasprc",
    "codeql",
    "corepack",
    "crossgantt",
    "cspell",
    "datetime",
    "dedupe",
    "displayorder",
    "gantt",
    "grapheme",
    "httponly",
    "ichiuji",
    "indexeddb",
    "issuekey",
    "kaku",
    "lookarounds",
    "markdownlint",
    "mischeck",
    "millis",
    "nodate",
    "nulab",
    "openharmony",
    "openssf",
    "oxfmt",
    "oxlint",
    "pipefail",
    "rolldown",
    "segmenter",
    "setstate",
    "shellcheck",
    "stylelint",
    "tsgo",
    "tsgolint",
    "unhover",
    "unstyled",
    "unthrown",
    "vitest",
    "zunda"
  ],
  "ignoreRegExpList": ["/[\\p{Script=Hiragana}\\p{Script=Katakana}\\p{Script=Han}ー－、。「」（）]+/gu"]
}
