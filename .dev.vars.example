# ローカル開発用の環境変数。`.dev.vars` にコピーして値を埋める。
# `.dev.vars` は .gitignore 済みなので、実際の値をコミットしないこと。
#
# Backlog Developer サイト（https://backlog.com/developer/applications/）で
# アプリを登録して取得する。リダイレクト URI は登録した値と完全に一致させる必要があるため、
# ローカル用と本番用でアプリを分けて登録するのが確実。
#   ローカル: http://localhost:5173/api/auth/callback
#   本番:     https://<worker のドメイン>/api/auth/callback
BACKLOG_CLIENT_ID=
BACKLOG_CLIENT_SECRET=

# リダイレクト URI を固定したい場合のみ設定する。
# 未設定ならリクエストのオリジンから自動的に組み立てる。
# OAUTH_REDIRECT_URI=
